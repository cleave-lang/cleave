(* ============================================================
   Cleave grammar in EBNF (ISO/IEC 14977 dialect).

   This file describes the surface syntax the parser actually
   implements today. Productions not yet implemented are listed
   at the bottom under "(* planned *)" with no semantics.

   Reading guide:
     - identifiers in quotes are literal token text
     - identifiers in CamelCase reference a production below
     - identifiers in UPPER_CASE reference a lexer token kind
       (defined in compiler/include/lexer.h)
     - `?` means optional, `*` means zero-or-more,
       `+` means one-or-more, `|` is alternation, `,` is sequence.

   Companion: compiler/src/parser.c implements this grammar.
   ============================================================ *)


(* ---------- top-level ---------- *)

Program
    = TopLevel*
    ;

TopLevel
    = ChainDecl
    | ModuleDecl
    | ProtocolDecl
    ;

ChainDecl
    = "chain", IDENT, "{",
        ( SubsystemAssign, [ ";" | "," ] )*,
      "}"
    ;

SubsystemAssign
    = SubsystemKey, ":", TypeExpr
    ;

(* Any identifier is a valid subsystem key (issue #64). The five names
   below are the stdlib axes and remain reserved as keyword tokens for
   reasons unrelated to the chain manifest (state and gas also start
   module-item declarations). Chains can declare additional axes by
   inventing new identifier names, which makes third-party protocol
   extensions a first-class language feature. *)

SubsystemKey
    = IDENT       (* includes the stdlib axes:
                     "consensus", "gas", "state", "exec", "da" *)
    ;


(* ---------- modules ---------- *)

ModuleDecl
    = "module", IDENT, "{", ModuleItem*, "}"
    ;

ModuleItem
    = StateDecl
    | GasDecl
    | EventDecl
    | EffectDecl
    | FnDecl
    ;

StateDecl
    = "state", IDENT, ":", TypeExpr
    ;

GasDecl
    = "gas", IDENT, "=", Expr
    ;

EventDecl
    = "event", IDENT, "(", [ ParamList ], ")"
    ;

EffectDecl
    = "effect", IDENT, "(", [ ParamList ], ")", [ "->", TypeExpr ], [ "deferred" ]
    ;

FnDecl
    = [ "pure" | "view" ], "fn", IDENT, "(", [ ParamList ], ")",
      [ "->", TypeExpr ],
      [ "with", "[", [ IDENT, ( ",", IDENT )* ], "]" ],
      Block
    ;

ParamList
    = Param, ( ",", Param )*, [ "," ]
    ;

Param
    = IDENT, ":", TypeExpr
    ;


(* ---------- protocols ---------- *)

ProtocolDecl
    = "protocol", IDENT, [ "implements", TypeExpr ],
      "{", ProtocolItem*, "}"
    ;

ProtocolItem
    = StateDecl
    | EffectDecl
    | FnDecl
    | SlashOnDecl
    ;

SlashOnDecl
    = "slash_on", IDENT, "{",
        ( IDENT, ":", TypeExpr, [ "," ] )*,
      "}",
      [ "when", Expr ],
      [ "penalty", Expr ]
    ;


(* ---------- statements + expressions ---------- *)

Block
    = "{", Stmt*, [ Expr ], "}"
    ;

Stmt
    = LetStmt
    | ReturnStmt
    | IfStmt
    | MatchStmt
    | ExprStmt
    ;

LetStmt
    = "let", IDENT, [ ":", TypeExpr ], "=", Expr
    ;

ReturnStmt
    = "return", [ Expr ]
    ;

IfStmt
    = "if", Expr, Block, [ "else", ( Block | IfStmt ) ]
    ;

MatchStmt
    = "match", Expr, "{", MatchArm*, "}"
    ;

MatchArm
    = Expr, "=>", Expr, [ "," ]
    ;

ExprStmt
    = Expr
    ;

(* Expressions form a precedence-climbed binary expression grammar.
   The full operator table lives in compiler/src/parser.c::binary_prec
   and mirrors tree-sitter-cleave/grammar.js exactly. Higher numbers
   bind tighter:
       10  *  /
        9  +  -
        8  ==  !=  <  >  <=  >=
        7  &&
        6  ||
        5  =
   Unary operators (!, -) and postfix operators (call, index, member,
   path, percent) bind tighter than any binary operator. *)

Expr
    = PrefixExpr, ( BinaryOp, PrefixExpr )*
    ;

PrefixExpr
    = ( "!" | "-" )?, PostfixExpr
    ;

PostfixExpr
    = Primary, PostfixSuffix*
    ;

PostfixSuffix
    = "(", [ Expr, ( ",", Expr )* ], ")"   (* call *)
    | "[", Expr, "]"                       (* index *)
    | ".", IDENT                           (* member *)
    | "::", IDENT                          (* path *)
    | "%"                                  (* percent *)
    ;

Primary
    = IDENT
    | NUMBER
    | STRING
    | CHAR
    | "true" | "false" | "null"
    | "(", Expr, ")"
    | Block
    | RecordLiteral
    ;

RecordLiteral
    = "{", RecordField, ( ",", RecordField )*, [ "," ], "}"
    ;

RecordField
    = IDENT, ":", Expr
    ;

BinaryOp
    = "*" | "/" | "+" | "-"
    | "==" | "!=" | "<" | ">" | "<=" | ">="
    | "&&" | "||" | "="
    ;


(* ---------- types ---------- *)

TypeExpr
    = TypeNamed
    | TypeGeneric
    ;

TypeNamed
    = IDENT
    ;

TypeGeneric
    = IDENT, "<", TypeArgs, ">"
    ;

TypeArgs
    = TypeParam, ( ",", TypeParam )*, [ "," ]
    ;

TypeParam
    = [ IDENT, "=" ], TypeParamValue
    ;

TypeParamValue
    = IDENT
    | NUMBER
    | STRING
    | SetLiteral
    ;

(* { a, b, c } as a positional set of identifiers / numbers.
   Modeled in the AST as an anonymous TypeGeneric with empty name. *)
SetLiteral
    = "{", SetValue, ( ",", SetValue )*, [ "," ], "}"
    ;

SetValue
    = IDENT
    | NUMBER
    | STRING
    ;


(* ---------- terminals ---------- *)

(* IDENT: [a-zA-Z_][a-zA-Z0-9_]*, distinguished from reserved keywords.
   See KEYWORDS in compiler/src/lexer.c. *)
IDENT       = ? lexer token TK_IDENT ? ;

(* NUMBER: decimal, hex (0x...), or binary (0b...), with optional
   `_` separators between digits. No floating point in v0. *)
NUMBER      = ? lexer token TK_NUMBER ? ;

(* STRING: "..." with backslash escapes. The lexeme retains its
   surrounding quotes and raw escape sequences; unescaping is
   the parser's job at a later stage. *)
STRING      = ? lexer token TK_STRING ? ;


(* ============================================================
   Productions not yet in the grammar.

   These appear in the standard-library RFCs and example files
   but the parser does not yet accept them. They land in their
   own issues.

     - Closure expressions:        `|param| body`
     - Unit type and value:        `()`
     - Struct literals (shorthand):
         `StructName { field_a, field_b: expr }`
     - Nested subsystem blocks:
         `exec { primary: ..., embedded: [...] }`
     - Lambda / move-capture variants
     - Pattern grammar beyond simple identifiers in match arms
   ============================================================ *)
